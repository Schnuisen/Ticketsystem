QDialog { background: #f4f7fb; color: #172033; font-family: "Segoe UI"; font-size: 14px; }
QLabel { color: #334155; font-weight: 600; }
QLineEdit, QPlainTextEdit, QComboBox { background: white; border: 1px solid #d8e0ea; border-radius: 8px; padding: 8px 10px; color: #1f2937; }
QLineEdit:focus, QPlainTextEdit:focus, QComboBox:focus { border: 1px solid #2f7be5; }
QPushButton { background: white; border: 1px solid #d8e0ea; border-radius: 8px; padding: 8px 14px; }
QPushButton:hover { background: #edf4ff; }
QPushButton#saveButton { background: #2f7be5; color: white; border: none; font-weight: 600; }
QPushButton#saveButton:hover { background: #246bcb; }
